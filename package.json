{
  "name": "accessible-smart-map-backend",
  "version": "1.0.0",
  "description": "Backend server for Accessible Smart Map project",
  "main": "dist/server.js",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "backfill:way-names": "npx dotenvx run -- python3 src/scripts/backfill-osm-way-names.py",
    "build": "pnpm run lint:arch && tsc",
    "build:otp": "pnpm run generate:gtfs-parents && docker compose run --rm otp --build --save",
    "build:ped-graph": "npx dotenvx run -- python3 src/scripts/build-ped-graph.py",
    "bench:ped-router": "npx dotenvx run -- node --expose-gc -r ts-node/register src/scripts/ped-router-phase0-bench.ts",
    "bench:ped-router-vs-otp": "npx dotenvx run -- ts-node src/scripts/ped-router-otp-comparison.ts",
    "build:traffic-map": "npx dotenvx run -- ts-node src/scripts/generate-tdx-valhalla-map.ts",
    "build:traffic-tar": "npx dotenvx run -- ts-node src/scripts/build-traffic-tar.ts",
    "build:valhalla-tiles": "bash src/scripts/build-valhalla-tiles.sh",
    "capture:rail-fixtures": "npx dotenvx run -- ts-node src/scripts/capture-rail-station-fixtures.ts",
    "clean": "rimraf dist",
    "dev": "dotenvx run -- nodemon",
    "diagnose:ped-connectivity": "npx dotenvx run -- python3 src/scripts/diagnose-ped-graph-connectivity.py",
    "eval:routing": "npx dotenvx run -- ts-node src/scripts/eval-tool-routing.ts",
    "generate:gtfs-parents": "npx dotenvx run -- ts-node src/scripts/generate-gtfs-parents.ts",
    "hazard:expire": "npx dotenvx run -- ts-node src/scripts/expire-hazard-reports.ts",
    "import:a11y-metro": "npx dotenvx run -- ts-node src/scripts/import-a11y-metro.ts",
    "import:bathrooms": "npx dotenvx run -- ts-node src/scripts/import-bathrooms.ts",
    "import:campus-a11y": "npx dotenvx run -- ts-node src/scripts/import-campus-a11y.ts",
    "import:campus-facility-detail": "npx dotenvx run -- ts-node src/scripts/import-campus-facility-detail.ts",
    "import:gtfs-all": "npx dotenvx run -- node --max-old-space-size=2048 -r ts-node/register src/scripts/import-gtfs-all.ts",
    "inject:ped-indoor": "npx dotenvx run -- python3 src/scripts/inject-ped-indoor-graph.py",
    "import:osm": "npx dotenvx run -- ts-node src/scripts/import-osm-a11y.ts",
    "import:parking-tdx": "npx dotenvx run -- ts-node src/scripts/import-tdx-parking.ts",
    "import:rag": "npx dotenvx run -- ts-node src/scripts/import-rag.ts",
    "import:taipei-ramps": "npx dotenvx run -- ts-node src/scripts/import-taipei-ramps.ts",
    "import:tdx-bus-routes": "npx dotenvx run -- ts-node src/scripts/import-tdx-bus-routes.ts",
    "import:tdx-bus-vehicles": "npx dotenvx run -- ts-node src/scripts/import-tdx-bus-vehicles.ts",
    "import:tdx-metro": "npx dotenvx run -- ts-node src/scripts/import-tdx-metro.ts",
    "import:tdx-stops": "npx dotenvx run -- ts-node src/scripts/import-tdx-stops.ts",
    "import:tdx-thsr": "npx dotenvx run -- ts-node src/scripts/import-tdx-thsr.ts",
    "import:tdx-tra": "npx dotenvx run -- ts-node src/scripts/import-tdx-tra.ts",
    "import:visual-a11y": "npx dotenvx run -- ts-node src/scripts/import-visual-a11y.ts",
    "import:welfare": "npx dotenvx run -- ts-node src/scripts/import-welfare.ts",
    "import:traffic-sections": "npx dotenvx run -- ts-node src/scripts/import-traffic-sections.ts",
    "lint": "eslint .",
    "lint:arch": "node src/scripts/check-architecture.mjs",
    "lint:fix": "eslint . --fix",
    "migrate:ped-graph-lifecycle": "npx dotenvx run -- ts-node src/scripts/migrate-ped-graph-lifecycle.ts",
    "postinstall": "pnpm run build",
    "promote:ped-graph": "npx dotenvx run -- ts-node src/scripts/promote-ped-graph.ts",
    "prebuild": "pnpm run clean",
    "smoke:line-agent": "npx dotenvx run -- ts-node src/scripts/smoke-line-agent.ts",
    "smoke:tdx-traffic": "npx dotenvx run -- ts-node src/scripts/smoke-tdx-traffic.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:python": "python3 src/scripts/run-python-tests.py",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "express",
    "typescript",
    "backend",
    "taipei",
    "accessible"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@dotenvx/dotenvx": "^2.21.0",
    "@google-cloud/storage": "^7.22.0",
    "@google-cloud/vision": "^6.0.0",
    "@google/genai": "^2.17.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@line/bot-sdk": "^11.2.0",
    "@scalar/express-api-reference": "^0.10.13",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.2",
    "chromadb": "^3.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "flatbush": "^4.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "mime": "^4.1.0",
    "mongoose": "^9.9.2",
    "morgan": "^1.10.0",
    "mqtt": "^5.15.2",
    "multer": "^2.2.0",
    "openai": "^7.4.0",
    "opencc-js": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "proj4": "^2.20.9",
    "rate-limit-redis": "^6.0.1",
    "rimraf": "^6.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "gaxios": "^7.3.1",
      "teeny-request": "^11.0.1",
      "@types/express": "^5.0.6"
    }
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  }
}
