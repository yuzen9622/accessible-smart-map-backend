+package org.opentripplanner.street.search.request;
+
+import java.util.Map;
+import org.opentripplanner.street.model.edge.*;
+import org.opentripplanner.street.search.state.State;
+
+public record DirectWalkPolicy(Profile profile, boolean avoidStairs) implements ExtensionRequestContext, java.io.Serializable {
+  public enum Profile { NORMAL, WHEELCHAIR }
+  public static final String VERSION = "sidewalk-priority-v1";
+
+  public static DirectWalkPolicy of(String profile, boolean avoidStairs) {
+    return new DirectWalkPolicy(Profile.valueOf(profile), avoidStairs);
+  }
+
+  public boolean allows(Edge edge, StreetSearchRequest request) {
+    if (edge instanceof StreetEdge street) {
+      if (street.getPedestrianRole() == null) throw new IllegalStateException("Sidewalk priority requires a rebuilt graph");
+      if (avoidStairs && street.isStairs()) return false;
+      if (profile == Profile.WHEELCHAIR && (!street.isWheelchairAccessible()
+          || street.getMaxSlope() > Math.nextUp((float) request.wheelchair().maxSlope())
+          || profileMaxSlope(street) > Math.nextUp((float) request.wheelchair().maxSlope())
+          || street.getKnownPedestrianWidth() < 0.9)) return false;
+    }
+    if (edge instanceof EscalatorEdge && (avoidStairs || profile == Profile.WHEELCHAIR)) return false;
+    if (edge instanceof PathwayEdge pathway) {
+      if (avoidStairs && (pathway.getSteps() != 0 || pathway.hasStairsOrEscalator())) return false;
+      if (profile == Profile.WHEELCHAIR && (!pathway.isWheelchairAccessible()
+          || Math.abs(pathway.getSlope()) > request.wheelchair().maxSlope())) return false;
+    }
+    if (profile == Profile.WHEELCHAIR) {
+      var forbidden = org.opentripplanner.core.model.accessibility.Accessibility.NOT_POSSIBLE;
+      if (edge instanceof ElevatorHopEdge elevator && elevator.getWheelchairAccessibility() == forbidden) return false;
+      if (edge instanceof StreetTransitEntityLink<?> link && link.getWheelchairAccessibility() == forbidden) return false;
+    }
+    return true;
+  }
+
+  public static double profileMaxSlope(StreetEdge street) {
+    var samples = street.getElevationProfile();
+    if (samples == null || samples.size() < 2) return Double.NaN;
+    double maximum = 0;
+    for (int i = 1; i < samples.size(); i++) {
+      double run = samples.getX(i) - samples.getX(i-1);
+      double rise = samples.getY(i) - samples.getY(i-1);
+      if (!Double.isFinite(run) || !Double.isFinite(rise) || run <= 0) return Double.NaN;
+      maximum = Math.max(maximum, Math.abs(rise/run));
+    }
+    return maximum;
+  }
+
+  public static PedestrianEdgeRole role(Edge edge) {
+    if (edge instanceof StreetEdge street) {
+      var role = street.getPedestrianRole();
+      if (role == null) throw new IllegalStateException("Sidewalk priority requires captured edge roles");
+      return role;
+    }
+    return edge instanceof PathwayEdge || edge instanceof ElevatorEdge || edge instanceof EscalatorEdge
+      ? PedestrianEdgeRole.SIDEWALK : PedestrianEdgeRole.OTHER;
+  }
+
+  public static long lengthMillimetres(Edge edge) {
+    double metres = edge.getDistanceMeters();
+    if (!(metres > 0)) {
+      var geometry = edge.getGeometry();
+      metres = geometry != null
+        ? org.opentripplanner.street.geometry.SphericalDistanceLibrary.length(geometry)
+        : org.opentripplanner.street.geometry.SphericalDistanceLibrary.distance(
+          edge.getFromVertex().getCoordinate(), edge.getToVertex().getCoordinate());
+    }
+    if (!Double.isFinite(metres) || metres < 0) throw new IllegalStateException("Unknown edge length");
+    return Math.round(metres * 1000);
+  }
+
+  public static long exposureMillimetres(Edge edge) {
+    var role = role(edge);
+    return role == PedestrianEdgeRole.CARRIAGEWAY || role == PedestrianEdgeRole.OTHER
+      ? lengthMillimetres(edge) : 0;
+  }
+
+  public Map<String,Object> evidence(java.util.List<State> states) {
+    var first = states.getFirst();
+    var last = states.getLast();
+    var edges = states.stream().skip(1).map(State::getBackEdge).map(e -> Map.<String,Object>of(
+        "role", role(e).name(), "distanceMillimetres", lengthMillimetres(e),
+        "osmWayId", e instanceof StreetEdge street ? Long.toString(street.getOsmWayId()) : "")).toList();
+    var result = new java.util.LinkedHashMap<String,Object>(Map.of("version",VERSION,"profile",profile.name(),"avoidStairs",avoidStairs,
+      "carriagewayMillimetres",last.getPrimaryWeight()-first.getPrimaryWeight(),
+      "generalizedCost",last.getWeight()-first.getWeight(),"edges",edges));
+    boolean knownElevation = states.stream().skip(1).map(State::getBackEdge).anyMatch(e -> e instanceof StreetEdge)
+      && states.stream().skip(1).map(State::getBackEdge).allMatch(e ->
+        e instanceof StreetEdge street ? !street.isElevationFlattened() && Double.isFinite(profileMaxSlope(street))
+          : e instanceof ElevatorEdge || lengthMillimetres(e) == 0);
+    result.put("maxSlopePercent", profile == Profile.WHEELCHAIR && knownElevation ? first.getRequest().wheelchair().maxSlope()*100 : null);
+    return java.util.Collections.unmodifiableMap(result);
+  }
+}
