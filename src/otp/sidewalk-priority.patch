+package org.opentripplanner.street.model.edge;
+
+public enum PedestrianEdgeRole {
+  CARRIAGEWAY, SIDEWALK, CROSSING, OTHER;
+
+  public static PedestrianEdgeRole fromOsm(String highway, String footway) {
+    if ("crossing".equals(footway) || "crossing".equals(highway)) return CROSSING;
+    if (highway == null) return OTHER;
