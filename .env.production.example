# production

NODE_ENV=production
PORT=8000
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
SECURE_COOKIE=true

DATABASE_URL='mongodb://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:27017/accessible_map?authSource=admin&replicaSet=rs0&directConnection=true'
MONGO_ROOT_USER=<DB_ROOT_USER>
MONGO_ROOT_PASSWORD=<DB_ROOT_PASSWORD>

REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379

MEMORY_ENCRYPTION_KEY=<GENERATE_64_BYTE_RANDOM_KEY>

CHROMA_URL=http://chroma:8100


JWT_ACCESS_SECRET=<GENERATE_HIGH_ENTROPY_RANDOM_SECRET>
JWT_REFRESH_SECRET=<GENERATE_HIGH_ENTROPY_RANDOM_SECRET>

GOOGLE_CLIENT_ID=<YOUR_PRODUCTION_GOOGLE_CLIENT_ID>.apps.googleusercontent.com

GEMINI_API_KEY=<YOUR_PRODUCTION_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com

OPENAI_API_KEY=

GEMINI_LIVE_TEMPERATURE=0
GEMINI_LIVE_LANGUAGE_CODE=cmn-TW

GEMINI_CORRECTION_MODEL=gemini-3.8-flash


# ------------------------------------------
# 5. 地圖與公共交通 API (Maps & Public Transport)
# ------------------------------------------
# Google Maps API Key (生產環境請綁定 HTTP Referer / IP 限制)
GOOGLE_MAPS_API_KEY=<YOUR_PRODUCTION_GOOGLE_MAPS_API_KEY>

# 交通部 TDX 平台 API 金鑰
TDX_CLIENT_ID=<YOUR_TDX_CLIENT_ID>
TDX_CLIENT_SECRET=<YOUR_TDX_CLIENT_SECRET>
TDX_TOKEN_ENDPOINT=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
TDX_TOKEN_SAFETY_SECONDS=60

# 中央氣象署 (CWA) OpenData API Key
CWA_API_KEY=<YOUR_CWA_API_KEY>

# Photon & Nominatim 地名查詢服務位址
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=taipei-accessible-backend-prod (<CONTACT_EMAIL>)


# ------------------------------------------
# 6. 路徑規劃服務引擎 (Routing Engines: OTP & Valhalla)
# ------------------------------------------
# OpenTripPlanner (OTP2) GraphQL 服務位址
OTP_BASE_URL=http://otp:8080
OTP_DATA_DIR=./otp-data
OTP_SERVE_XMX=16g
OTP_GTFS_URLS="https://tdx.transportdata.tw/api/gtfs/V3/Map/GTFS/Static"
OTP_TIMEOUT_MS=30000
OTP_SEARCH_WINDOW_S=3600
OTP_SEARCH_WINDOW_WIDE_S=28800

# Self-hosted Valhalla 導航服務
VALHALLA_BASE_URL=http://valhalla:8002
VALHALLA_DATA_DIR=./valhalla-data
VALHALLA_PBF_PATH=./otp-data/taiwan-latest.osm.pbf
VALHALLA_THREADS=4


# ------------------------------------------
# 7. 通報與 Google Cloud Storage (Hazard Reports)
# ------------------------------------------
# GCS 儲存桶名稱 (正式環境通報照片)
GCS_BUCKET_NAME=hazard_report_prod

# GCS / Cloud Vision 服務帳號 JSON Key 檔案路徑 (若在 GCP 上可留空以使用 ADC)
GCS_KEY_FILE=/etc/secrets/gcs-key.json

# 照片上傳大小上限 (MB)
HAZARD_PHOTO_MAX_SIZE_MB=10

# 回報者與問題地點之最大允許距離 (公尺)
HAZARD_REPORT_MAX_DISTANCE_M=20

# 障礙通報過期自動掃描間隔 (毫秒)
HAZARD_EXPIRY_SCAN_INTERVAL_MS=3600000

# 是否啟用 AI 影像通報防偽/障礙檢驗
USE_HAZARD_AI_VERIFY=true

# 是否啟用 Vision API 初步過濾
USE_VISION_PREFILTER=true


# ------------------------------------------
# 8. 郵件與前端連結 (Email & Web Frontend)
# ------------------------------------------
# Resend Email 服務 API Key
RESEND_API_KEY=<YOUR_RESEND_API_KEY>

# 寄件者 Email 地址 (需在 Resend 完成網域 DNS 驗證)
RESEND_FROM=no-reply@map.yuzen.dev

# 正式前端 Web 應用程式基底網址
APP_WEB_BASE_URL=https://map.yuzen.dev

LINE_CHANNEL_ACCESS_TOKEN=<YOUR_LINE_CHANNEL_ACCESS_TOKEN>
LINE_CHANNEL_SECRET=<YOUR_LINE_CHANNEL_SECRET>
LINE_BOT_BASIC_ID=

PUBLIC_TRACKING_BASE_URL=https://map.yuzen.dev
PUBLIC_LIFF_ROUTE_BASE_URL=https://map.yuzen.dev/zh-TW

# 室內圖資導航
USE_INDOOR_GRAPH=true

# 即時電梯/設施故障狀態
USE_REALTIME_FACILITY=true

# 即時公車與捷運進站動態
USE_REALTIME_TRANSIT=true
