# ==========================================
# 台北無障礙導航後端 (Taipei Accessible Map)
# 開發環境變數範例 (.env.development.example)
# ==========================================

# ------------------------------------------
# 1. 系統與伺服器設定 (Core & Server)
# ------------------------------------------
# 執行環境 (development / production / test)
NODE_ENV=development

# API 伺服器 Port
PORT=8000

# 允許跨域請求來源 (逗號分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Express trust proxy 反向代理跳數 (開發環境通常為 1 或 0)
TRUST_PROXY_HOPS=1

# Cookie 是否僅在 HTTPS 下傳送 (開發環境一般為 false)
SECURE_COOKIE=false


# ------------------------------------------
# 2. 資料庫與快取 (Databases & Cache)
# ------------------------------------------
# MongoDB 連線 URL
DATABASE_URL=mongodb://<user>:<password>@localhost:27018/accessible_map?authSource=admin

# MongoDB Root 管理員帳號密碼 (用於本地 Docker setup)
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Redis 連線 URL (用於 LINE 對話狀態與快取)
REDIS_URL=redis://localhost:6379

# 使用者記憶內容加密金鑰 (AES-256，建議使用隨機 32-64 bytes 字串)
MEMORY_ENCRYPTION_KEY=<GENERATE_64_BYTE_RANDOM_KEY>

# Chroma 向量資料庫位址
CHROMA_URL=http://localhost:8100


# ------------------------------------------
# 3. 身份驗證與安全 (Auth & JWT)
# ------------------------------------------
# JWT Access Token 簽署金鑰
JWT_ACCESS_SECRET=your-jwt-access-secret-development-key

# JWT Refresh Token 簽署金鑰
JWT_REFRESH_SECRET=your-jwt-refresh-secret-development-key

# Google Client ID (用於 Google 帳號登入驗證)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# ------------------------------------------
# 4. AI 服務與 LLM API (Google Gemini & OpenAI)
# ------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# 主模型名稱 (如 gemini-3.5-flash, gemini-3-flash-preview)
GEMINI_MODEL=gemini-3.5-flash

# Gemini API Endpoint (非預設端點時填寫)
GEMINI_API_URL=https://generativelanguage.googleapis.com

# 可選 OpenAI API Key (當 Gemini 相容層調用時備用)
OPENAI_API_KEY=

# --- Gemini Live 語音 POC (Phase 0) ---
# 實時語音互動模型
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Voice Live 採樣溫度 (預設 0，範圍 0-2)
GEMINI_LIVE_TEMPERATURE=0
# Voice Live 輸出合成語言 (如 cmn-TW)
GEMINI_LIVE_LANGUAGE_CODE=cmn-TW
# 是否掛載 Voice POC 前端測試頁面 (/api/v1/voice/poc)
VOICE_POC_ENABLED=true
# 是否在伺服器 Log 輸出完整 Tool Traces (開發開啟)
VOICE_POC_TRACE=true
# 語音逐字稿台灣地名/站名校正 (預設啟用)
VOICE_TRANSCRIPT_CORRECTION=true
# 語音校正使用之 LLM 模型 (未設定則沿用 GEMINI_MODEL)
GEMINI_CORRECTION_MODEL=gemini-3.5-flash


# ------------------------------------------
# 5. 地圖與公共交通 API (Maps & Public Transport)
# ------------------------------------------
# Google Maps API Key (用於 Geocoding, Places 等)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 交通部 TDX 平台 API 金鑰
TDX_CLIENT_ID=your-tdx-client-id
TDX_CLIENT_SECRET=your-tdx-client-secret
TDX_API_KEY=
TDX_TOKEN_ENDPOINT=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
TDX_TOKEN_SAFETY_SECONDS=60

# 中央氣象署 (CWA) OpenData API Key (環境天氣模組)
CWA_API_KEY=your-cwa-api-key

# Photon & Nominatim 地名查詢服務位址
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=taipei-accessible-backend-dev


# ------------------------------------------
# 6. 路徑規劃服務引擎 (Routing Engines: OTP & Valhalla)
# ------------------------------------------
# OpenTripPlanner (OTP2) GraphQL 服務位址
OTP_BASE_URL=http://localhost:18080
OTP_DATA_DIR=./otp-data
OTP_SERVE_XMX=12g
OTP_GTFS_URLS="https://tdx.transportdata.tw/api/gtfs/V3/Map/GTFS/Static"
OTP_TIMEOUT_MS=30000
OTP_SEARCH_WINDOW_S=3600
OTP_SEARCH_WINDOW_WIDE_S=28800

# Self-hosted Valhalla 導航服務
VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_DATA_DIR=./valhalla-data
VALHALLA_PBF_PATH=./otp-data/taiwan-latest.osm.pbf
VALHALLA_THREADS=2


# ------------------------------------------
# 7. 通報與 Google Cloud Storage (Hazard Reports)
# ------------------------------------------
# GCS 儲存桶名稱 (通報照片上傳)
GCS_BUCKET_NAME=hazard_report

# GCS / Cloud Vision 服務帳號 JSON Key 檔案路徑
GCS_KEY_FILE=/path/to/your/gservice-key.json

# 照片上傳大小上限 (MB)
HAZARD_PHOTO_MAX_SIZE_MB=10

# 回報者與問題地點之最大允許距離 (公尺)
HAZARD_REPORT_MAX_DISTANCE_M=20

# 障礙通報過期自動掃描間隔 (毫秒)
HAZARD_EXPIRY_SCAN_INTERVAL_MS=3600000

# 是否啟用 AI 影像通報防偽/障礙檢驗
USE_HAZARD_AI_VERIFY=true

# 是否啟用 Vision API 初步過濾
USE_VISION_PREFILTER=true


# ------------------------------------------
# 8. 郵件與前端連結 (Email & Web Frontend)
# ------------------------------------------
# Resend Email 服務 API Key (留空則僅將驗證連結輸出至 Log)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=no-reply@localhost

# 前端 Web 應用程式基底網址 (用於驗證信與密碼重設連結)
APP_WEB_BASE_URL=http://localhost:3000


# ------------------------------------------
# 9. LINE 官方帳號與 SOS 追蹤 (LINE & SOS)
# ------------------------------------------
# LINE Messaging API Channel Access Token
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# LINE Channel Secret
LINE_CHANNEL_SECRET=your-line-channel-secret

# LINE 官方帳號 Basic ID
LINE_BOT_BASIC_ID=@254ialbu

# 公開追蹤頁面基底網址 (前端網域)
PUBLIC_TRACKING_BASE_URL=http://localhost:3000

# LINE LIFF 路線預覽網址
PUBLIC_LIFF_ROUTE_BASE_URL=http://localhost:3000/zh-TW


# ------------------------------------------
# 10. 內部功能開關 (Internal Feature Flags)
# ------------------------------------------
# 是否啟用室內圖資導航 (Indoor Graph)
USE_INDOOR_GRAPH=true

# 是否啟用即時電梯/設施故障狀態
USE_REALTIME_FACILITY=true

# 是否啟用即時公車與捷運進站動態
USE_REALTIME_TRANSIT=true
