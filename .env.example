# ==========================================
# 台北無障礙導航後端 (Taipei Accessible Map)
# 通用環境變數範例 (.env.example)
# ==========================================

NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1
SECURE_COOKIE=false

# --- 資料庫與快取 ---
DATABASE_URL=mongodb://localhost:27017/accessible_map
MONGO_ROOT_USER=app
MONGO_ROOT_PASSWORD=password
REDIS_URL=redis://localhost:6379
MEMORY_ENCRYPTION_KEY=
CHROMA_URL=http://localhost:8100
# PostGIS 行人無障礙圖：`postgis` service 的初始化帳號。
PED_PG_USER=ped_graph
PED_PG_PASSWORD=change-me
# PostGIS 行人無障礙圖：離線建圖與載入器連線 URI（主機埠 5433）。
PED_GRAPH_DATABASE_URL=postgresql://ped_graph:change-me@127.0.0.1:5433/ped_graph
# 純步行 CSR 開關：僅在 lifecycle migration、候選圖驗證／promote 與 shadow runtime 完成後明確設為 true。
# 未設定時一律維持關閉，即使 PED_GRAPH_DATABASE_URL 已設定；OTP2 會保持 primary。
PED_GRAPH_CSR_WALK_ENABLED=false
# CSR 圖首次載入／ACTIVE 版本重載的單次上限（毫秒）。
PED_GRAPH_LOAD_TIMEOUT_MS=120000
# 檢查 ACTIVE 圖版本是否已 promote 的最短間隔（毫秒）。
PED_GRAPH_REFRESH_INTERVAL_MS=300000

# --- JWT & Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_CLIENT_ID=

# --- AI & LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com
OPENAI_API_KEY=

# --- Voice POC (Phase 0, Gemini Live API) ---
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_TEMPERATURE=0
GEMINI_LIVE_LANGUAGE_CODE=cmn-TW
VOICE_POC_ENABLED=false
VOICE_POC_TRACE=false
VOICE_TRANSCRIPT_CORRECTION=true
GEMINI_CORRECTION_MODEL=

# --- 地圖與外部 API ---
GOOGLE_MAPS_API_KEY=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TDX_API_KEY=
TDX_TOKEN_ENDPOINT=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
TDX_TOKEN_SAFETY_SECONDS=60
# TDX MQTT 營運通阻推播：憑證取自會員中心「資料存取金鑰」，與上方 REST OAuth 憑證不同組
TDX_MQTT_ENABLED=false
TDX_MQTT_HOST=mqtt.transportdata.tw
TDX_MQTT_PORT=8883
TDX_MQTT_CLIENT_ID=
TDX_MQTT_CLIENT_USERNAME=
TDX_MQTT_CLIENT_PASSWORD=
CWA_API_KEY=
# MOENV 空品資料：環境部環境資料開放平臺（https://data.moenv.gov.tw，免費註冊會員後取得）

PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=taipei-accessible-backend (contact: unset)

# --- 路由引擎 ---
OTP_BASE_URL=http://localhost:8080
OTP_DATA_DIR=./otp-data
OTP_SERVE_XMX=12g
OTP_GTFS_URLS="https://tdx.transportdata.tw/api/gtfs/V3/Map/GTFS/Static"
OTP_TIMEOUT_MS=30000
OTP_SEARCH_WINDOW_S=3600
OTP_SEARCH_WINDOW_WIDE_S=28800
# 格式 minLng,minLat,maxLng,maxLat；必須設為 OTP/Valhalla 實際圖資涵蓋範圍的交集。若 OTP_OSM_BBOX 有裁切，部署時必須同步設定。
SERVICE_COVERAGE_BBOX=
# 單次路線直線距離上限（公里）；留空用預設 750（涵蓋全台灣 bbox 對角線）。
# 若 SERVICE_COVERAGE_BBOX 裁切為單一城市，建議同步設為較小值（如 100）。
SERVICE_MAX_ROUTE_DISTANCE_KM=

VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_DATA_DIR=./valhalla-data
VALHALLA_PBF_PATH=./otp-data/taiwan-latest.osm.pbf
VALHALLA_THREADS=2

# --- TDX 即時路況（Road/Traffic）---
# 路徑以 pnpm smoke:tdx-traffic 實測為準：即時路況在 v2/Road/Traffic 下，
# 即時事件在另一個服務根 v1/Traffic/RoadEvent 下。全部有安全預設，可不設。
TDX_ROAD_TRAFFIC_BASE_URL=https://tdx.transportdata.tw/api/basic/v2/Road/Traffic
TDX_ROAD_EVENT_BASE_URL=https://tdx.transportdata.tw/api/basic/v1/Traffic/RoadEvent
# 留空＝關閉整個路況功能（導航自動退回自由流）
# 即時路況（Live）只服務其中 9 個；NewTaipei 對 Live 回 400，僅用於即時事件查詢，會被自動濾掉。
TRAFFIC_TARGET_CITIES=Taipei,NewTaipei,Taoyuan,Taichung,Tainan,Keelung,YilanCounty,ChanghuaCounty,YunlinCounty,PingtungCounty
TRAFFIC_FLOW_LIVE_SOFT_TTL_SEC=90
TRAFFIC_FLOW_LIVE_HARD_TTL_SEC=300
TRAFFIC_LIVE_REFRESH_INTERVAL_MS=60000
TRAFFIC_REFRESH_LOCK_TTL_SEC=50
TRAFFIC_GEOMETRY_REFRESH_INTERVAL_MS=21600000
TRAFFIC_CORRIDOR_PAD_M=30
TRAFFIC_BEARING_TOLERANCE_DEG=45
TRAFFIC_MAX_CANDIDATES_PER_SEGMENT=32
TRAFFIC_FLOW_LIVE_ERR_TTL_SEC=15
TRAFFIC_CONGESTION_DEF_TTL_SEC=86400
TRAFFIC_INCIDENT_TTL_SEC=60
TRAFFIC_INCIDENT_ERR_TTL_SEC=15
TRAFFIC_FETCH_TIMEOUT_MS=8000
TRAFFIC_ROUTE_HOOK_TIMEOUT_MS=2500
TRAFFIC_FLOW_MAX_BBOX_DEG=0.5

# --- 通報與 GCS ---
GCS_BUCKET_NAME=
GCS_KEY_FILE=
HAZARD_PHOTO_MAX_SIZE_MB=10
HAZARD_REPORT_MAX_DISTANCE_M=20
HAZARD_EXPIRY_SCAN_INTERVAL_MS=3600000
USE_HAZARD_AI_VERIFY=true
USE_VISION_PREFILTER=true

# --- 郵件與前端 ---
RESEND_API_KEY=
RESEND_FROM=no-reply@2026.yuzen.dev
APP_WEB_BASE_URL=http://localhost:3000
# At least 32 random bytes; keep stable across deploys so queued reset links remain retryable.
PASSWORD_RESET_TOKEN_SECRET=

# --- LINE & SOS ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=
PUBLIC_TRACKING_BASE_URL=http://localhost:3000
PUBLIC_LIFF_ROUTE_BASE_URL=http://localhost:3000/zh-TW

# --- 功能開關 ---
USE_INDOOR_GRAPH=true
USE_REALTIME_FACILITY=true
USE_REALTIME_TRANSIT=true
