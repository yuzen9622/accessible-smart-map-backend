# ==========================================
# 台北無障礙導航後端 (Taipei Accessible Map)
# .env.example
#
# 原則：這裡只列「沒設就會壞、或部署時一定要改」的變數。
# 其餘設定在程式碼中都有預設值，需要覆寫時才自行加上（見檔案最後的清單）。
# ==========================================

# --- 必填：資料連線 ---
DATABASE_URL=mongodb://localhost:27017/accessible_map
REDIS_URL=redis://localhost:6379
PED_GRAPH_DATABASE_URL=postgresql://ped_graph:change-me@127.0.0.1:5433/ped_graph

# --- 必填：密鑰 ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 至少 32 bytes 隨機值；跨部署必須固定，否則已寄出的重設密碼連結會失效。
PASSWORD_RESET_TOKEN_SECRET=
# 未設定時，AI 記憶功能會停用（不加密就不寫入）。
MEMORY_ENCRYPTION_KEY=

# --- 必填：外部 API ---
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional comma-separated allowlist of actual ID-token audiences for this backend.
# When set, GOOGLE_CLIENT_IDS is authoritative; only include audiences issued for tokens sent to this server.
# GOOGLE_CLIENT_IDS=<BACKEND_AUDIENCE_1>,<BACKEND_AUDIENCE_2>
# Legacy single audience, used only when GOOGLE_CLIENT_IDS is unset.
GOOGLE_CLIENT_ID=
# Optional comma-separated allowlist of Sign in with Apple audiences (App Bundle ID / Services ID).
# When set, APPLE_CLIENT_IDS is authoritative; when unset it defaults to the App Bundle ID com.accessiblemap.app.
# APPLE_CLIENT_IDS=com.accessiblemap.app
# Sign in with Apple private key (Apple Developer → Keys, "Sign in with Apple" enabled), used to revoke
# Apple tokens when an account is deleted (App Store requirement). The first APPLE_CLIENT_IDS entry is the client_id.
# APPLE_PRIVATE_KEY is the .p8 PEM content; literal "\n" sequences are turned into newlines.
# When any of the three is unset, account deletion still works but skips Apple revocation (logged as an error).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# TDX MQTT 營運通阻即時推播：憑證取自會員中心「資料存取金鑰」，與上方 REST OAuth 不同組。
# 服務啟動時一律嘗試連線；缺憑證會在 log 印 "TDX MQTT failed" 但不影響其他功能。
TDX_MQTT_CLIENT_ID=
TDX_MQTT_CLIENT_USERNAME=
TDX_MQTT_CLIENT_PASSWORD=
# 環境部環境資料開放平臺 https://data.moenv.gov.tw（免費註冊）
MOENV_API_KEY=
# 中央氣象署開放資料
CWA_API_KEY=
RESEND_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- 必填：通報照片儲存與影像審核（GCP）---
# Cloud Vision 預篩沒有單獨金鑰，與 GCS 共用同一個 service account。
GCS_BUCKET_NAME=
GCS_KEY_FILE=

# --- 必填：AI 記憶向量庫 ---
CHROMA_URL=http://localhost:8100

# --- 部署環境 ---
NODE_ENV=development
# Comma-separated exact web origins, including the deployed frontend. Never use *.
# Credentialed photo GET requests require the frontend origin here.
CORS_ORIGINS=http://localhost:3000
APP_WEB_BASE_URL=http://localhost:3000
PUBLIC_TRACKING_BASE_URL=http://localhost:3000
PUBLIC_LIFF_ROUTE_BASE_URL=http://localhost:3000/zh-TW
# 正式環境（跨網域 cookie）必須設 true。
SECURE_COOKIE=false

# --- 服務涵蓋範圍（正式部署務必確認）---
# 格式 minLng,minLat,maxLng,maxLat；必須是 OTP/Valhalla 實際圖資範圍的交集。
# 留空＝全台灣。若 OTP_OSM_BBOX 有裁切，這裡要同步設定。
SERVICE_COVERAGE_BBOX=
# 單次路線直線距離上限（公里）；留空用預設 750。bbox 若裁成單一城市建議設 100。
SERVICE_MAX_ROUTE_DISTANCE_KM=

# --- docker-compose / 離線建圖專用（不是應用程式讀的）---
MONGO_ROOT_USER=app
MONGO_ROOT_PASSWORD=password
PED_PG_USER=ped_graph
PED_PG_PASSWORD=change-me
OTP_DATA_DIR=./otp-data
OTP_SERVE_XMX=12g
OTP_GTFS_URLS="https://tdx.transportdata.tw/api/gtfs/V3/Map/GTFS/Static"
VALHALLA_DATA_DIR=./valhalla-data
VALHALLA_PBF_PATH=./otp-data/taiwan-latest.osm.pbf
VALHALLA_THREADS=2
CLOUDFLARE_TUNNEL_TOKEN=

# ==========================================
# 以下都是「已在程式碼寫好預設值」的調校參數。
# 功能本身一律啟用，這裡只是讓你在需要時覆寫數值；
# 不寫進 .env 不會關掉任何功能。
# ==========================================

# 服務基本
# PORT=3000
# TRUST_PROXY_HOPS=1

# AI 模型
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_API_URL=            # 只在自架 proxy 時設；設錯會讓所有 AI 呼叫 404
# GEMINI_CORRECTION_MODEL=
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_TEMPERATURE=0
# GEMINI_LIVE_LANGUAGE_CODE=cmn-TW

# 路由引擎
# OTP_BASE_URL=http://localhost:8080
# OTP_TIMEOUT_MS=30000
# OTP_SEARCH_WINDOW_S=3600
# OTP_SEARCH_WINDOW_WIDE_S=7200
# OTP_CONTINUATION_WINDOW_S=28800
# 無合格候選時，搜尋出發班次的總範圍；獨立於每輪窗口，預設保留原有 24 小時覆蓋。
# OTP_SEARCH_HORIZON_S=86400
# 一次大眾運輸規劃所有 OTP 階段共用的總時限（毫秒）；主查詢之後的加搜只用剩餘時間，用完即略過。
# ROUTE_PLAN_BUDGET_MS=45000
# OTP_NUM_ITINERARIES=8
# OTP_NUM_ITINERARIES_WIDE=15
# 路線低底盤歷史（只用於排序）：至少幾輛不同車、觀察幾天內、車型已知比例下限
# LOW_FLOOR_MIN_DISTINCT_PLATES=5
# LOW_FLOOR_EVIDENCE_MAX_AGE_DAYS=30
# LOW_FLOOR_MIN_TYPE_COVERAGE=0.8
# 車牌出現在哪條路線的觀察紀錄保留天數
# BUS_FLEET_SIGHTING_TTL_DAYS=30
# VALHALLA_BASE_URL=http://localhost:8002
# PED_GRAPH_LOAD_TIMEOUT_MS=120000
# PED_GRAPH_REFRESH_INTERVAL_MS=300000

# 地理編碼
# PHOTON_BASE_URL=https://photon.komoot.io
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=taipei-accessible-backend (contact: unset)

# TDX 權杖
# TDX_TOKEN_ENDPOINT=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
# TDX_TOKEN_SAFETY_SECONDS=60
# TDX_MQTT_HOST=mqtt.transportdata.tw
# TDX_MQTT_PORT=8883

# 即時路況刷新節奏（TDX 配額主要由這裡決定）
# 每個 target 依所屬 tier 各自計時；worker 每個 base tick（= 最短的 tier 間隔）醒一次，
# 只刷新該輪到期的 target。快取 TTL 一律由間隔推導（soft = 1.5x、hard = 5x），
# 刻意不開放獨立設定：soft TTL 一旦短於間隔，讀取路徑會每個請求都判定 stale
# 並追一次 TDX 呼叫，呼叫量反而暴增。
# TRAFFIC_LIVE_PRIMARY_TARGETS=Taipei          # 走快節奏的 target，逗號分隔
# TRAFFIC_LIVE_PRIMARY_INTERVAL_MS=60000       # 核心城市：1 分鐘
# TRAFFIC_LIVE_STANDARD_INTERVAL_MS=300000     # 其餘縣市與國道／省道：5 分鐘
# TRAFFIC_REFRESH_LOCK_TTL_SEC=50              # 必須小於 base tick，鎖才會在下一輪前自行過期


# 通報
# HAZARD_PHOTO_MAX_SIZE_MB=10
# HAZARD_EXPIRY_SCAN_INTERVAL_MS=300000
# HAZARD_REVIEW_STALE_SKIPPED_MS=600000
# 路況回報 AI 審核停發開關；設為 false 只停止領取新審核，intake 清理與逾時收斂（排隊審核 5 分鐘 deadline 後轉 failed）仍持續執行
# HAZARD_AI_WORKER_ENABLED=true

# 隱私資料保存（docs/PRIVACY_DATA_RETENTION.md）。期限天數只能縮短、不能超過隱私政策上限；
# 設定不合法時服務啟動即失敗。以下皆為預設值。
# RETENTION_SCAN_INTERVAL_MS=3600000            # 上限 6 小時
# RETENTION_SAFETY_MARGIN_MS=86400000           # 提前於期限處理；須 ≥ 2 × 掃描間隔
# RETENTION_BATCH_SIZE=200
# RETENTION_RUN_BUDGET_MS=300000
# RETENTION_RECONCILE_INTERVAL_MS=21600000      # 補掃（刪除帳號、孤兒向量）；須 ≤ 安全緩衝 / 2，且加 grace ≤ 安全緩衝
# SOS_RESOLVED_DEADLINE_DAYS=30                 # 上限 30
# CONTACT_LOCATION_DEADLINE_DAYS=30             # 上限 30
# HAZARD_REPORT_DEADLINE_DAYS=90                # 上限 90
# MEMORY_UNUSED_DEADLINE_DAYS=365               # 上限 365
# SOS_STALE_AUTO_RESOLVE_HOURS=24               # 位置多久沒更新就自動解除；下限 6
# SOS_NOTICE_MAX_ATTEMPTS=10
# SOS_NOTICE_LEASE_MS=900000
# SOS_NOTICE_SEND_TIMEOUT_MS=10000              # 須小於 lease
# MEMORY_TOMBSTONE_KEEP_DAYS=30                 # 無內容的刪除紀錄，用於向量補掃；上限 30
# MEMORY_VECTOR_GRACE_MS=600000
# MEMORY_INDEX_TIMEOUT_MS=30000                 # 須小於 grace
# ACCOUNT_SWEEP_QUIET_MS=86400000
# ACCOUNT_SWEEP_CAP_DAYS=30                     # 上限 30
# HAZARD_PHOTO_CACHE_MAX_AGE_SEC=3600           # 須 ≤ 安全緩衝

# 郵件與 LINE
# RESEND_FROM=no-reply@2026.yuzen.dev
# LINE_BOT_BASIC_ID=@xxxxxxx
# EXPO_ACCESS_TOKEN=                 # 只有 Expo 專案開啟 Enhanced Push Security 時才需要

# 僅維運腳本使用（不屬於服務運行期）
# OLD_MEMORY_ENCRYPTION_KEY=         # pnpm rotate-memory-key 輪替金鑰時才需要
# VALHALLA_TILES_DIR=./valhalla-data/active/valhalla_tiles
# VALHALLA_TRAFFIC_EXTRACT_PATH=./valhalla-data/traffic/traffic.tar
# VALHALLA_EDGE_MAP_PATH=./valhalla-data/traffic/tdx-valhalla-edge-map.json
